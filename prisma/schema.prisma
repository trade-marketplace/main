// Database schema. Supabase Postgres (Sydney), see DECISIONS.md (#58).
// Schema changes need William's review (AGENTS.md §4).
//
// Conventions:
// - Tables and columns are snake_case in Postgres (@@map / @map), camelCase in TypeScript.
// - Every table has row-level security on (set in the migration SQL). The app's server code connects as the
//   table owner, so it is not limited by those policies; they protect the Supabase Data API, which the browser
//   can reach with the public key. Users may only read their own rows there; every write goes through our server.
// - Timestamps are timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A07 (#184): public waitlist submissions go through the server; no Data API access.
model WaitlistEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(254)
  suburb    String   @db.VarChar(80)
  suburbKey String   @map("suburb_key") @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([email, suburbKey])
  @@map("waitlist_entries")
}

// ---------------------------------------------------------------- Schema 1 (#86): people

enum Role {
  CUSTOMER
  TRADIE
  ADMIN

  @@map("role")
}

// The trades a worker can do and a job can need. Same list as job categories (Schema 2, #87).
// OTHER is any labour (moving, cleaning, gardening, assembly…) and never needs a licence (DECISIONS.md 1).
enum Trade {
  ELECTRICAL
  PLUMBING
  GAS
  CONSTRUCTION
  OTHER

  @@map("trade")
}

enum LicenceStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("licence_status")
}

// One row per person who can sign in. `id` is the Supabase Auth user id (auth.users.id): Supabase Auth owns
// the password and sessions, this table holds what the app needs. Deleting the auth user deletes the profile.
model Profile {
  id              String    @id @db.Uuid
  // Lowercased and trimmed by a trigger on every insert and update, so `Sam@X.nz` and `sam@x.nz` are one person.
  email           String    @unique
  // Copied from Supabase Auth when the person confirms their email (sign-in, #101).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  role            Role      @default(CUSTOMER)
  // Public pages show the first name and last initial only.
  firstName       String    @map("first_name")
  lastName        String?   @map("last_name")
  // NZ mobile in E.164 (+6421…). Hidden from the other side until a job is claimed (DECISIONS.md 11).
  phone           String?
  // Path in the private Supabase Storage bucket, never a public URL.
  avatarPath      String?   @map("avatar_path")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workerProfile    WorkerProfile?
  workerTrades     WorkerTrade[]
  licences         Licence[]          @relation("LicenceHolder")
  licencesChecked  Licence[]          @relation("LicenceChecker")
  workersVerified  WorkerProfile[]    @relation("WorkerVerifier")
  addresses        Address[]
  payrollDetails   PayrollDetails?
  jobsPosted       Job[]              @relation("JobCustomer")
  jobsAssigned     Job[]              @relation("JobWorker")
  jobPhotos        JobPhoto[]
  estimates        Estimate[]
  jobsPriced       JobPricing[]
  statusChanges    JobStatusHistory[]
  extraWorkAsked   Variation[]        @relation("VariationRequester")
  extraWorkPriced  Variation[]        @relation("VariationPricer")
  payouts          Payout[]
  settingsChanged  Settings[]
  evidenceRules    TradeEvidenceRule[]
  evidenceSent     CompletionEvidence[] @relation("EvidenceWorker")
  evidenceChecked  CompletionEvidence[] @relation("EvidenceChecker")
  reviewsWritten   Review[]           @relation("ReviewAuthor")
  reviewsReceived  Review[]           @relation("ReviewWorker")
  reviewsReported  Review[]           @relation("ReviewReporter")
  reviewsHidden    Review[]           @relation("ReviewHider")
  notifications    Notification[]
  notificationPreferences NotificationPreference[]
  problemsReported ProblemReport[]    @relation("ProblemReporter")
  problemsResolved ProblemReport[]    @relation("ProblemResolver")
  supportThreads   SupportThread[]
  supportMessages  SupportMessage[]

  @@map("profiles")
}

// Tradie / worker details. Only TRADIE profiles have one (tradie sign-up, #105, creates it).
model WorkerProfile {
  userId       String    @id @map("user_id") @db.Uuid
  user         Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  // Work area: a base suburb and a radius around its centre (10 / 25 / 50 km on the form).
  baseSuburb   String?   @map("base_suburb")
  areaLat      Float?    @map("area_lat")
  areaLng      Float?    @map("area_lng")
  areaRadiusKm Int?      @map("area_radius_km")
  // Off until the worker turns it on, so nobody is sent jobs before they've finished setting up.
  available    Boolean   @default(false)
  // Verified badge: set by the office when the worker has been checked (DECISIONS.md 1).
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz
  verifiedById String?   @map("verified_by_id") @db.Uuid
  verifiedBy   Profile?  @relation("WorkerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  // Verified quoters arrive in milestone 5 (#258). Invite only.
  isQuoter     Boolean   @default(false) @map("is_quoter")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Finding available workers near a job: a bounding box on lat/lng, then the exact distance in code (#97).
  @@index([available, areaLat, areaLng])
  @@map("worker_profiles")
}

// The trades a worker does. A worker can do several.
model WorkerTrade {
  userId    String    @map("user_id") @db.Uuid
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade     Trade
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  licence   Licence?

  @@id([userId, trade])
  // Finding workers by trade.
  @@index([trade])
  @@map("worker_trades")
}

// A licence for one of the worker's trades. Status is per trade: a worker can be verified for electrical and
// still pending for plumbing. One row per worker per trade; "Try again" after a rejection updates the row and
// the audit log (#100) keeps the history. OTHER never has a licence (checked by the database).
// How licences are checked is still being decided (#64), so `type` is free text for now.
model Licence {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            Profile       @relation("LicenceHolder", fields: [userId], references: [id], onDelete: Cascade)
  trade           Trade
  // Removing a trade from a worker removes its licence.
  workerTrade     WorkerTrade   @relation(fields: [userId, trade], references: [userId, trade], onDelete: Cascade)
  number          String
  // e.g. "Registered electrician", "Certifying plumber".
  type            String?
  status          LicenceStatus @default(PENDING)
  // Required when REJECTED; shown to the worker with "Try again".
  rejectionReason String?       @map("rejection_reason")
  checkedById     String?       @map("checked_by_id") @db.Uuid
  checkedBy       Profile?      @relation("LicenceChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  // Required when VERIFIED or REJECTED.
  checkedAt       DateTime?     @map("checked_at") @db.Timestamptz
  expiresOn       DateTime?     @map("expires_on") @db.Date
  // Path of the uploaded licence in the private Storage bucket.
  documentPath    String?       @map("document_path")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, trade])
  // Office queue: licences waiting to be checked, oldest first.
  @@index([status, createdAt])
  @@map("licences")
}

// A customer's saved addresses (C21). At most one default per person (checked by the database).
// lat/lng come from address search or a dropped pin, and are empty when the address was only typed (#97).
model Address {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. "Home", "Rental on Dee St".
  label          String?
  line1          String
  line2          String?
  suburb         String
  city           String
  postcode       String?
  lat            Float?
  lng            Float?
  // Where lat/lng came from (#97). Empty for addresses saved before #97.
  locationSource LocationSource? @map("location_source")
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("addresses")
}

// A worker's bank and tax details for payroll (D15). Only the server reads this table: no Data API policy.
// The IRD number and bank account are encrypted by the app before they're saved (src/server/crypto.ts, key
// from FIELD_ENCRYPTION_KEY). The last digits are kept in the clear so the page can show them masked.
model PayrollDetails {
  userId               String   @id @map("user_id") @db.Uuid
  user                 Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  irdNumberEncrypted   String?  @map("ird_number_encrypted")
  irdNumberLast3       String?  @map("ird_number_last3")
  bankAccountEncrypted String?  @map("bank_account_encrypted")
  bankAccountLast4     String?  @map("bank_account_last4")
  // IRD tax code, e.g. "M", "SB", "ND".
  taxCode              String?  @map("tax_code")
  // KiwiSaver employee contribution in whole percent; empty when not enrolled.
  kiwiSaverRatePct     Int?     @map("kiwisaver_rate_pct")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payroll_details")
}

// ---------------------------------------------------------------- Schema 2 (#87): jobs

// Where a job is. QUOTE_BOUNTY is when the price can't be settled from photos and estimates and someone has to
// go and look (DECISIONS.md 2, page C22/D19). Customers see their own words for these, never the raw names.
enum JobStatus {
  // Posted; workers send blind estimates and the office prices it. Editable by the customer until priced.
  REVIEW
  QUOTE_BOUNTY
  // Price sent to the customer, waiting for them to pay.
  PRICED
  // Paid; open for a worker to claim.
  BOOKABLE
  // Claimed by a worker.
  ASSIGNED
  // Worker has finished and sent the evidence; waiting on the customer's sign-off (48h).
  SUBMITTED
  COMPLETED
  // Cancelled after payment: the office reviews it.
  CANCEL_REVIEW
  CANCELLED

  @@map("job_status")
}

// Where an address's or job's lat/lng came from (#97).
enum LocationSource {
  // Picked from address search (Mapbox).
  SEARCH
  // Address not found (new subdivision, rural): typed by hand and a pin dropped on the map.
  PIN
  // Address search was down: typed by hand, no lat/lng yet.
  TYPED

  @@map("location_source")
}

// Whether a job's location is inside the coverage area (settings, Schema 3). CHECK_LATER: there was no point to
// check (address search was down), so the office checks it.
enum CoverageCheck {
  INSIDE
  OUTSIDE
  CHECK_LATER

  @@map("coverage_check")
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING

  @@map("time_of_day")
}

// A job a customer has posted. Customers see their own jobs, including the price they pay (`priceCents`).
// What the worker earns and how the price was built are in `job_pricing`, which customers never see.
model Job {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Shown as TM-1001 (also the order number for supplier accounts). Starts at 1001.
  jobNumber          Int             @unique @default(autoincrement()) @map("job_number")
  customerId         String          @map("customer_id") @db.Uuid
  customer           Profile         @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  category           Trade
  title              String
  description        String
  // Copied from the address the customer picked, so editing a saved address never moves a posted job.
  // The full address is for the assigned worker only; others see the suburb (#95).
  addressLine1       String          @map("address_line1")
  addressLine2       String?         @map("address_line2")
  suburb             String
  city               String
  postcode           String?
  lat                Float?
  lng                Float?
  // Where the location came from and whether it's in the coverage area, both copied when the job is posted
  // (#97, src/server/geo/job-location.ts). Empty for jobs posted before #97.
  locationSource     LocationSource? @map("location_source")
  coverage           CoverageCheck?
  // A dropped pin or a typed-only address: the office checks the location before the job goes out.
  locationNeedsCheck Boolean         @default(false) @map("location_needs_check")
  // The approximate pin shown to workers before the job is claimed: 100–300 m from the real point, picked at
  // random once and kept, so it never jumps and can't be worked back to the address. The database clears it
  // when lat/lng move without a new one.
  approxLat          Float?          @map("approx_lat")
  approxLng          Float?          @map("approx_lng")
  // Gate codes, dogs, parking.
  accessNotes        String?         @map("access_notes")
  // Urgent: raises the job in worker alerts.
  asap               Boolean         @default(false)
  // "Any time" works for the customer, so there may be no rows in `job_time_windows`.
  anyTime            Boolean         @default(false) @map("any_time")
  status             JobStatus       @default(REVIEW)
  // The worker who claimed it. Required from ASSIGNED on (checked by the database).
  workerId           String?         @map("worker_id") @db.Uuid
  worker             Profile?        @relation("JobWorker", fields: [workerId], references: [id], onDelete: Restrict)
  // What the customer pays, incl GST. Required from PRICED on, and can't change once paid (checked by the database).
  priceCents         Int?            @map("price_cents")
  // The window the worker booked: one of the customer's windows, or any window when `anyTime`.
  bookedDate         DateTime?       @map("booked_date") @db.Date
  bookedTime         TimeOfDay?      @map("booked_time")
  // Set by the database whenever what the job is (title, description, category, address, photos…) changes.
  // Estimates saved before it are flagged `madeBeforeEdit`.
  editedAt           DateTime?       @map("edited_at") @db.Timestamptz
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  photos        JobPhoto[]
  timeWindows   JobTimeWindow[]
  estimates     Estimate[]
  pricing       JobPricing?
  statusHistory JobStatusHistory[]
  payments      Payment[]
  variations    Variation[]
  payouts       Payout[]
  materials     JobMaterials?
  evidence      CompletionEvidence?
  review        Review?
  problems      ProblemReport[]
  support       SupportThread[]

  // Job board and office queues by status and trade; the map by status and location.
  @@index([status, category])
  @@index([status, lat, lng])
  @@index([customerId, createdAt])
  @@index([workerId, status])
  // Office queue: locations to check, oldest first.
  @@index([locationNeedsCheck, createdAt])
  @@map("jobs")
}

// Photos of the job. The customer's own, in the private Storage bucket (DECISIONS.md, #59).
model JobPhoto {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String   @map("job_id") @db.Uuid
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Path in the private Supabase Storage bucket, never a public URL.
  path         String
  // Gallery order, first is the cover.
  position     Int      @default(0)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedBy   Profile? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId, position])
  @@map("job_photos")
}

// When the customer can have the work done: a date and part of the day (DECISIONS.md 10). Workers book one.
model JobTimeWindow {
  jobId     String    @map("job_id") @db.Uuid
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  timeOfDay TimeOfDay @map("time_of_day")

  @@id([jobId, date, timeOfDay])
  @@map("job_time_windows")
}

// A worker's blind estimate: they never see each other's, and customers never see any (AGENTS.md §5).
// One per worker per job; saving again updates it. Hours are stored as minutes (3.5 h = 210).
model Estimate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId       String   @map("worker_id") @db.Uuid
  worker         Profile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  minutes        Int
  // Materials at cost, ex GST.
  materialsCents Int      @default(0) @map("materials_cents")
  note           String?
  // "Needs a site visit" tick in the estimate drawer.
  needsSiteVisit Boolean  @default(false) @map("needs_site_visit")
  // True when the job was edited after this estimate was last saved. Set and cleared by the database.
  madeBeforeEdit Boolean  @default(false) @map("made_before_edit")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([jobId, workerId])
  // A worker's estimates history (D13).
  @@index([workerId, createdAt])
  @@map("estimates")
}

// How a job's price was built, frozen when the office prices it: the rates are copied from settings (Schema 3)
// so a later change there never changes an agreed price or payout. Can't change once the job is paid (checked
// by the database). Only the server reads this table: no Data API policy. Percentages are basis points
// (20% = 2000) and hours are minutes, so everything is a whole number.
model JobPricing {
  jobId            String   @id @map("job_id") @db.Uuid
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Copied from settings when priced.
  workerRateCents  Int      @map("worker_rate_cents")
  minMinutes       Int      @map("min_minutes")
  holidayPayBps    Int      @map("holiday_pay_bps")
  onCostBps        Int      @map("on_cost_bps")
  marginBps        Int      @map("margin_bps")
  gstBps           Int      @map("gst_bps")
  // What was priced: billed time (after the minimum) and materials at cost, ex GST.
  minutes          Int
  materialsCents   Int      @map("materials_cents")
  // The result. The customer's total is `jobs.price_cents`.
  workerGrossCents Int      @map("worker_gross_cents")
  holidayPayCents  Int      @map("holiday_pay_cents")
  onCostCents      Int      @map("on_cost_cents")
  marginCents      Int      @map("margin_cents")
  gstCents         Int      @map("gst_cents")
  // Office note on how it was priced (e.g. "trimmed average of 3, +30 min access").
  note             String?
  pricedById       String?  @map("priced_by_id") @db.Uuid
  pricedBy         Profile? @relation(fields: [pricedById], references: [id], onDelete: SetNull)
  pricedAt         DateTime @default(now()) @map("priced_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("job_pricing")
}

// Every status a job has had, oldest first. Written by the database on every insert and status change, so
// nothing can skip it. The server names who made the change with `SET LOCAL app.actor_id = '<profile id>'`
// in the same transaction; empty means the system (e.g. a scheduled job).
model JobStatusHistory {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String     @map("job_id") @db.Uuid
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Empty for the first row, when the job was posted.
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  changedById String?    @map("changed_by_id") @db.Uuid
  changedBy   Profile?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId, createdAt])
  @@map("job_status_history")
}

// ---------------------------------------------------------------- Schema 3 (#91): money

// What a payment is for. A job can have several: the job itself, each piece of extra work, and the $30 quick
// look (DECISIONS.md 3). Quick looks and quote bounties may be replaced by #279 (DECISIONS.md "Still to decide").
enum PaymentKind {
  JOB
  VARIATION
  QUICK_LOOK

  @@map("payment_kind")
}

enum PaymentStatus {
  // Created with the provider, not paid yet.
  PENDING
  PAID
  // Declined or abandoned. Trying again makes a new payment with a new idempotency key.
  FAILED
  // All of `amountCents` was given back.
  REFUNDED
  // Some of it was: `refundedCents` says how much.
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

// Extra work found on the job: the worker asks, the office prices it, the customer says yes (and pays) or no.
enum VariationStatus {
  REQUESTED
  PRICED
  APPROVED
  DECLINED

  @@map("variation_status")
}

// Payouts are records for payroll, not bank transfers: they're exported to the payroll provider, which pays.
enum PayoutStatus {
  // Waiting for the next pay run.
  QUEUED
  // Sent to payroll in an export.
  EXPORTED
  // Payroll confirmed it was paid.
  PAID

  @@map("payout_status")
}

// Money the customer pays, through Stripe (DECISIONS.md 7), in test mode until both founders agree otherwise.
// Customers read their own jobs' payments; workers never see them (they hold the customer's price, AGENTS.md §5).
// Can't be deleted with the job: a job with payments has to stay. Once paid, what was paid can't change, and at
// most one payment for the same thing (the job, a variation, the quick look) is live at once: a FAILED one can
// be retried (all checked by the database).
model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId              String        @map("job_id") @db.Uuid
  job                Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  kind               PaymentKind
  // The extra work being paid for: set for VARIATION, and only then. Must be extra work on the same job.
  variationId        String?       @map("variation_id") @db.Uuid
  variation          Variation?    @relation(fields: [variationId], references: [id], onDelete: Restrict)
  // What the customer is charged, incl GST.
  amountCents        Int           @map("amount_cents")
  // Given back so far, for full and partial refunds. Never more than `amountCents`.
  refundedCents      Int           @default(0) @map("refunded_cents")
  status             PaymentStatus @default(PENDING)
  provider           String        @default("stripe")
  // Stripe's ids: the PaymentIntent (pi_…) and, when Checkout is used, the Checkout Session (cs_…).
  providerPaymentId  String?       @unique @map("provider_payment_id")
  providerCheckoutId String?       @unique @map("provider_checkout_id")
  // Sent with every request to the provider for this payment, so a retried request never charges twice.
  idempotencyKey     String        @unique @map("idempotency_key")
  // Stripe's `livemode`. False until real payments are switched on.
  livemode           Boolean       @default(false)
  // Why it failed, from the provider, for the office.
  failureReason      String?       @map("failure_reason")
  // Required once paid (PAID, REFUNDED, PARTIALLY_REFUNDED).
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz
  // The latest refund. Required once anything was refunded.
  refundedAt         DateTime?     @map("refunded_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([jobId, createdAt])
  @@index([variationId])
  // Office ledger and reconciliation by status.
  @@index([status, createdAt])
  @@map("payments")
}

// Extra work on a job (a "variation"): the worker asks (what and how long), the office prices it with the job's
// frozen rates from `job_pricing` (priced jobs keep their rates), the customer approves and pays, or declines.
// REQUESTED → PRICED → APPROVED | DECLINED; the office may re-price while PRICED; APPROVED and DECLINED are final
// (checked by the database). A row mixes the worker's ask, their pay and the customer's price, so it has no
// Data API policy: who sees which part arrives with who-sees-what (#95). Hours are minutes, as in Schema 2.
model Variation {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId                   String          @map("job_id") @db.Uuid
  job                     Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // The worker who asked.
  requestedById           String          @map("requested_by_id") @db.Uuid
  requestedBy             Profile         @relation("VariationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  description             String
  // The worker's ask: their time and materials at cost, ex GST.
  requestedMinutes        Int             @map("requested_minutes")
  requestedMaterialsCents Int             @default(0) @map("requested_materials_cents")
  status                  VariationStatus @default(REQUESTED)
  // Set by the office when it prices it (required from PRICED on, empty before): billed time, materials at
  // cost ex GST, then the result, built like `job_pricing`.
  minutes                 Int?
  materialsCents          Int?            @map("materials_cents")
  workerGrossCents        Int?            @map("worker_gross_cents")
  holidayPayCents         Int?            @map("holiday_pay_cents")
  onCostCents             Int?            @map("on_cost_cents")
  marginCents             Int?            @map("margin_cents")
  gstCents                Int?            @map("gst_cents")
  // What the customer pays for it, incl GST.
  priceCents              Int?            @map("price_cents")
  pricedById              String?         @map("priced_by_id") @db.Uuid
  pricedBy                Profile?        @relation("VariationPricer", fields: [pricedById], references: [id], onDelete: SetNull)
  // Set by the database when it's priced (and re-priced) and when the customer decides.
  pricedAt                DateTime?       @map("priced_at") @db.Timestamptz
  decidedAt               DateTime?       @map("decided_at") @db.Timestamptz
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  payments Payment[]

  @@index([jobId, createdAt])
  // Office queue: extra work waiting to be priced.
  @@index([status, createdAt])
  @@map("variations")
}

// What a worker is owed for a job, for payroll: one per worker per job, so a crew (milestone 4) gets one each.
// Minutes include approved extra work. `rateCents` is copied from the job's frozen pricing. Once exported, the
// amounts can't change and it can't go back to QUEUED (checked by the database). The worker reads their own
// payouts through the Data API; nobody else does.
model Payout {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String       @map("job_id") @db.Uuid
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  workerId        String       @map("worker_id") @db.Uuid
  worker          Profile      @relation(fields: [workerId], references: [id], onDelete: Restrict)
  minutes         Int
  // Per hour.
  rateCents       Int          @map("rate_cents")
  // minutes × rate, before PAYE.
  grossCents      Int          @map("gross_cents")
  // 8% for casual employees, paid as they go.
  holidayPayCents Int          @map("holiday_pay_cents")
  status          PayoutStatus @default(QUEUED)
  // Required from EXPORTED on.
  exportedAt      DateTime?    @map("exported_at") @db.Timestamptz
  // Required when PAID.
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([jobId, workerId])
  // A worker's earnings (T-earnings).
  @@index([workerId, createdAt])
  // The next pay run.
  @@index([status, createdAt])
  @@map("payouts")
}

// Materials for a job, bought on TM's trade account under the job number (TM-1005): the budget the worker may
// spend and what they actually spent, both at cost ex GST. Spend over budget is allowed and flagged for the office
// by the app. Materials at cost would show customers the margin, so there's no Data API policy; the worker's
// view of the budget arrives with who-sees-what (#95).
model JobMaterials {
  jobId        String    @id @map("job_id") @db.Uuid
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  budgetCents  Int       @map("budget_cents")
  // Empty until the worker reports it at finish.
  spentCents   Int?      @map("spent_cents")
  // Path of the receipt or supplier slip in the private Storage bucket.
  receiptPath  String?   @map("receipt_path")
  spentAt      DateTime? @map("spent_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("job_materials")
}

// The office's settings (F-settings): exactly one row, id 1, made by the migration with the launch rates
// (DECISIONS.md #62) and never deleted (checked by the database). Pricing a job copies the rates into
// `job_pricing`, so a change here never changes an agreed price or payout. Only the server reads this table:
// no Data API policy. Money is cents, percentages basis points (20% = 2000), time minutes or hours as named.
model Settings {
  id                   Int      @id @default(1)
  // The worker's hourly rate for every licensed trade (ELECTRICAL, PLUMBING, GAS, CONSTRUCTION) and for OTHER.
  // Per-trade rates may come later (DECISIONS.md 9).
  sharedRateCents      Int      @default(7000) @map("shared_rate_cents")
  otherRateCents       Int      @default(3800) @map("other_rate_cents")
  // Minimum billed time per job: 2 hours licensed, 1 hour Other.
  sharedMinMinutes     Int      @default(120) @map("shared_min_minutes")
  otherMinMinutes      Int      @default(60) @map("other_min_minutes")
  // Holiday pay on the worker's gross (8%), employer on-costs: KiwiSaver, ACC (12.5%), TM margin, GST.
  holidayPayBps        Int      @default(800) @map("holiday_pay_bps")
  onCostBps            Int      @default(1250) @map("on_cost_bps")
  marginBps            Int      @default(2000) @map("margin_bps")
  gstBps               Int      @default(1500) @map("gst_bps")
  // A submitted job is signed off automatically after this long without the customer answering.
  autoReleaseHours     Int      @default(48) @map("auto_release_hours")
  // The quick look the customer pays when a job needs someone to go and look (DECISIONS.md 2–3), incl GST.
  quickLookPriceCents  Int      @default(3000) @map("quick_look_price_cents")
  // How long a quote bounty stays open.
  bountyExpiryHours    Int      @default(24) @map("bounty_expiry_hours")
  // Where we work (#97): a circle around a centre, Invercargill at launch (DECISIONS.md 12). A job is covered
  // when its point is within `coverage_radius_km` of the centre: 60 km at launch (Matt, 26 Oct), 1–200 km.
  coverageCentreLat    Float    @default(-46.4132) @map("coverage_centre_lat")
  coverageCentreLng    Float    @default(168.3538) @map("coverage_centre_lng")
  coverageRadiusKm     Int      @default(60) @map("coverage_radius_km")
  updatedById          String?  @map("updated_by_id") @db.Uuid
  updatedBy            Profile? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// ---------------------------------------------------------------- Schema 4 (#92): after the job

// The office's check of a worker's evidence (F07). Empty until it's checked.
enum EvidenceCheck {
  APPROVED
  // Something's missing or wrong: the note says what, and the worker sends it again.
  FLAGGED

  @@map("evidence_check")
}

enum ProblemStatus {
  // Pauses the 48h auto sign-off while the office looks into it.
  OPEN
  RESOLVED

  @@map("problem_status")
}

enum SupportThreadStatus {
  OPEN
  CLOSED

  @@map("support_thread_status")
}

// Where a notification went besides the in-app list (every notification is a row, so it's always in the app).
// No SMS at launch (DECISIONS.md, #63): add it here when that changes.
enum NotificationChannel {
  EMAIL
  PUSH

  @@map("notification_channel")
}

// What a worker has to send to finish a job in each trade (D11 reads it; the office edits it in Settings, F14).
// One row per trade, made by the migration: electrical needs a CoC number and its PDF or photo; the other trades
// need photos and notes. A trade with no row isn't configured, and its evidence can't be sent (checked by the
// database), so the office can switch a trade's rules off without a deploy. Only the server reads this table.
model TradeEvidenceRule {
  trade           Trade    @id
  // Certificate of Compliance number, and its file.
  cocRequired     Boolean  @default(false) @map("coc_required")
  cocFileRequired Boolean  @default(false) @map("coc_file_required")
  minPhotos       Int      @default(0) @map("min_photos")
  notesRequired   Boolean  @default(false) @map("notes_required")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedBy       Profile? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("trade_evidence_rules")
}

// What the worker sends when they finish (D11) and the customer checks before signing off (C14). One per job,
// from the job's worker (the lead on a crew job). A draft until `submittedAt` ("Save for later"); sending it checks
// the trade's rules, the declaration and that materials spend is reported in `job_materials` (all by the
// database). Once sent it can't change, unless the office flags it and it goes back to a draft. No money here:
// materials spend lives in `job_materials`, which customers never see.
model CompletionEvidence {
  jobId       String         @id @map("job_id") @db.Uuid
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  workerId    String         @map("worker_id") @db.Uuid
  worker      Profile        @relation("EvidenceWorker", fields: [workerId], references: [id], onDelete: Restrict)
  // Certificate of Compliance (electrical): its number and the PDF or photo in the private Storage bucket.
  cocNumber   String?        @map("coc_number")
  cocPath     String?        @map("coc_path")
  notes       String?
  // The exact words the worker ticked, and when. Both required to send.
  declaration String?
  declaredAt  DateTime?      @map("declared_at") @db.Timestamptz
  submittedAt DateTime?      @map("submitted_at") @db.Timestamptz
  // The office's check (F07). FLAGGED needs a note saying what's wrong.
  officeCheck EvidenceCheck? @map("office_check")
  checkNote   String?        @map("check_note")
  checkedById String?        @map("checked_by_id") @db.Uuid
  checkedBy   Profile?       @relation("EvidenceChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime?      @map("checked_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  photos CompletionEvidencePhoto[]

  // Office queue: evidence waiting to be checked, oldest first.
  @@index([officeCheck, submittedAt])
  @@index([workerId, createdAt])
  @@map("completion_evidence")
}

// Photos of the finished work, in the private Storage bucket. Can't be added or removed once the evidence is sent.
model CompletionEvidencePhoto {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String             @map("job_id") @db.Uuid
  evidence  CompletionEvidence @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  path      String
  position  Int                @default(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId, position])
  @@map("completion_evidence_photos")
}

// The customer's review of the worker (C15), one per job, left when they sign off. Editable for 7 days:
// `editableUntil` is set by the database from `createdAt`, and the rating, tags and comment can't change after it
// (checked by the database). A worker can report a review; the office hides it with a reason (F12) and it
// disappears from public pages, but is kept.
model Review {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String    @unique @map("job_id") @db.Uuid
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  // The job's customer and worker (checked by the database).
  reviewerId    String    @map("reviewer_id") @db.Uuid
  reviewer      Profile   @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  workerId      String    @map("worker_id") @db.Uuid
  worker        Profile   @relation("ReviewWorker", fields: [workerId], references: [id], onDelete: Restrict)
  // 1–5 stars.
  rating        Int
  // Quick tags picked under the stars, e.g. "On time", "Tidy".
  tags          String[]  @default([])
  comment       String?
  editableUntil DateTime  @default(dbgenerated("(now() + '7 days'::interval)")) @map("editable_until") @db.Timestamptz
  // Reported by the worker (or anyone the office acts for): why, and when.
  reportedAt    DateTime? @map("reported_at") @db.Timestamptz
  reportedById  String?   @map("reported_by_id") @db.Uuid
  reportedBy    Profile?  @relation("ReviewReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportReason  String?   @map("report_reason")
  // Office moderation: hidden from public pages, with a reason. Both or neither.
  hiddenAt      DateTime? @map("hidden_at") @db.Timestamptz
  hiddenReason  String?   @map("hidden_reason")
  hiddenById    String?   @map("hidden_by_id") @db.Uuid
  hiddenBy      Profile?  @relation("ReviewHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // A worker's public profile: their visible reviews, newest first.
  @@index([workerId, createdAt])
  @@map("reviews")
}

// Something we told someone (E02, E03). `type` names the event in dotted lower case ("job.priced",
// "estimate.requested"); `payload` holds what the row shows and links to (job id, amounts the reader may see).
// The server builds the payload for its reader, so a worker's never holds the customer's price (AGENTS.md §5).
model Notification {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  user         Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  payload      Json                  @default("{}")
  readAt       DateTime?             @map("read_at") @db.Timestamptz
  // Where it was also sent, added as each one goes out.
  channelsSent NotificationChannel[] @default([]) @map("channels_sent")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  // The bell and the notifications page: newest first. Unread counts use a partial index (migration SQL).
  @@index([userId, createdAt])
  @@map("notifications")
}

// Event × optional-channel choices. In-app notifications are always kept (#98), so cannot be switched off here.
// No email or push provider sends yet. A missing row follows the event catalogue's defaults.
model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  user      Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([userId, event, channel])
  @@map("notification_preferences")
}

// "Something's not right" (C16): the customer or the worker on a job reports a problem. While one is OPEN the
// job isn't signed off automatically (the 48h job checks). The office resolves it with a note (F06).
model ProblemReport {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String        @map("job_id") @db.Uuid
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  // The job's customer or worker (checked by the database).
  reportedById String        @map("reported_by_id") @db.Uuid
  reportedBy   Profile       @relation("ProblemReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  // The topic picked on the form, e.g. "Work not finished". Free text until the list settles.
  topic        String
  details      String
  status       ProblemStatus @default(OPEN)
  // Required when RESOLVED, empty while OPEN.
  resolution   String?
  resolvedById String?       @map("resolved_by_id") @db.Uuid
  resolvedBy   Profile?      @relation("ProblemResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?     @map("resolved_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  photos        ProblemReportPhoto[]
  supportThread SupportThread?

  @@index([jobId, createdAt])
  // Office queue: open problems, oldest first.
  @@index([status, createdAt])
  @@map("problem_reports")
}

// Photos sent with a problem report, in the private Storage bucket.
model ProblemReportPhoto {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId  String        @map("report_id") @db.Uuid
  report    ProblemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  path      String
  position  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([reportId, position])
  @@map("problem_report_photos")
}

// A conversation between one person and the office (Help → "Message us", E08; the office inbox, F13).
// Optionally about a job or a problem report. The person sees their thread and its messages, never the office's
// internal notes.
model SupportThread {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  user            Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  jobId           String?             @map("job_id") @db.Uuid
  job             Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // At most one thread per problem report.
  problemReportId String?             @unique @map("problem_report_id") @db.Uuid
  problemReport   ProblemReport?      @relation(fields: [problemReportId], references: [id], onDelete: SetNull)
  status          SupportThreadStatus @default(OPEN)
  // Required when CLOSED, empty while OPEN.
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz
  // Moved forward by the database with each message, for sorting the inbox.
  lastMessageAt   DateTime            @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  messages SupportMessage[]

  @@index([userId, lastMessageAt])
  // Office inbox: open threads, latest first.
  @@index([status, lastMessageAt])
  @@map("support_threads")
}

// One message in a support thread: from the person or the office (`fromOffice`, set by the database from the
// author's role). `internal` notes are office-only and need an office author (checked by the database).
model SupportMessage {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId   String        @map("thread_id") @db.Uuid
  thread     SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // The thread's person or someone in the office (checked by the database). Empty if they've since been deleted.
  authorId   String?       @map("author_id") @db.Uuid
  author     Profile?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromOffice Boolean       @default(false) @map("from_office")
  internal   Boolean       @default(false)
  body       String
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([threadId, createdAt])
  @@map("support_messages")
}

// Who did what to which record, when (F05 timeline, F08 decisions, settings changes). Append-only: rows can't be
// changed or deleted (checked by the database), and `createdAt` is always the time of the insert. The audit helper
// (#100) writes it. `actorId` has no foreign key so the history outlives the person; empty means the system (a
// scheduled job). `recordId` is text because some keys aren't uuids (settings is id 1). Only the server reads it.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  // Their role at the time.
  actorRole  Role?    @map("actor_role")
  // Dotted lower case, e.g. "licence.verified", "job.refunded".
  action     String
  // The table and the row's key, e.g. "licences" + its id.
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  // The row (or just the changed fields) before and after. Empty for a create (before) or a delete (after).
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // A record's timeline, someone's actions, and everything by time.
  @@index([recordType, recordId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// Help article votes (#185). Browser key is a SHA-256 digest of a random, http-only cookie, never an IP/name.
// Server-only; no public read policy. William reviews this table before migration.
model HelpArticleFeedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleSlug String   @map("article_slug") @db.VarChar(100)
  voterKey    String   @map("voter_key") @db.VarChar(64)
  helpful     Boolean
  lookingFor  String?  @map("looking_for") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@unique([articleSlug, voterKey])
  @@map("help_article_feedback")
}
