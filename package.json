{
  "name": "trade-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/build-push-worker.mjs && next dev",
    "build": "prisma generate && node scripts/build-push-worker.mjs && next build",
    "vercel-build": "node scripts/migrate-on-deploy.mjs && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/require-db.mjs && prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/require-db.mjs && prisma db seed",
    "postinstall": "prisma generate",
    "next-task": "node scripts/next-task.mjs",
    "office-user": "node --conditions=react-server --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/office-user.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "firebase": "12.19.0",
    "google-auth-library": "11.3.3",
    "heic-decode": "2.1.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
