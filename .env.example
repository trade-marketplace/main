# Environment variables for Trade Marketplace.
# Copy this file to .env.local (never commit .env.local) and fill in what you need.
#
# DATABASE (optional for now)
# The app builds and runs without these: the database is simply off and `npm run dev` says so.
# Set BOTH to connect, or neither. Setting only one, or a malformed URL, stops the app with a clear error.
# Where to find them: Supabase dashboard → your project (region Sydney, ap-southeast-2)
#   → Project Settings → Database → Connection string. Replace [YOUR-PASSWORD] with the database password.
# On Vercel, add the same two variables under Project → Settings → Environment Variables.

# Pooled connection (Supavisor transaction mode, port 6543). Used by the app at runtime.
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct connection (port 5432). Used by `npm run db:migrate`; the pooled one can't run migrations.
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
DIRECT_URL=

# SUPABASE CLIENT (optional for now)
# For Supabase Auth (sign-in, #101) and Storage. Set BOTH or neither. Unset, everyone is signed out.
# Where to find them: Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# Both are public: they reach the browser. Access is enforced by row-level security, never by hiding these.
# Never put the secret / service_role key here.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts sb_publishable_). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FIELD ENCRYPTION (optional for now)
# Encrypts IRD numbers and bank accounts before they're saved (src/server/crypto.ts). Without it the app runs, but
# saving those details fails with a message saying how to set it. 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different key in each environment and keep it in the password manager: data saved with a key can't be
# read without it. Server only: never prefix it with NEXT_PUBLIC_.
FIELD_ENCRYPTION_KEY=

# MAPBOX (optional for now)
# Address search (autocomplete) when posting a job or saving an address (#97), limited to NZ and biased to the
# coverage area. Without it the app runs and people type their address by hand; the office checks the location.
# Where to find it: account.mapbox.com → Tokens. Called from our server only, so a secret (sk.) token with no
# extra scopes is fine; a public (pk.) one also works. Server only: never prefix it with NEXT_PUBLIC_.
MAPBOX_ACCESS_TOKEN=

# SEED DATA (npm run db:seed, #88; see docs/TESTING.md "Seed data")
# The seed fills a LOCAL or PREVIEW database with demo accounts and a job in every status. It refuses unless
# ALLOW_SEED=1 and the database is local (localhost), named "preview"/"local", or a Supabase project other than
# production. Never set ALLOW_SEED on production.
ALLOW_SEED=

# Password for every demo account (customer@, tradie@, worker@, office@demo.test). Needed when seeding a Supabase
# project, where the accounts really log in; a plain local Postgres has no Supabase Auth, so it's unused there.
# At least 10 characters. Keep it in the password manager; never commit it.
SEED_DEMO_PASSWORD=

# Server-only Supabase secret key (starts sb_secret_; the legacy service_role key also works). Only the seed uses it,
# to make the demo users through the Supabase Auth admin API on a preview/staging project. Never the production
# project's key, never NEXT_PUBLIC_, never committed.
SUPABASE_SECRET_KEY=
